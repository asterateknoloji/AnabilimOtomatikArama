# ===============================================
# ANABİLİM OTOMATİK ARAMA - ENVIRONMENT VARIABLES
# ===============================================
# Bu dosyayı kopyalayıp .env olarak kaydedin
# cp .env.example .env

# ===============================================
# AI CONFIGURATION
# ===============================================

# AI Type: 'openai' veya 'local'
AI_TYPE=openai

# ===============================================
# OPENAI (CLOUD AI)
# ===============================================

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-YOUR_API_KEY_HERE

# OpenAI Model
OPENAI_MODEL=gpt-4-turbo

# OpenAI TTS Voice (alloy, echo, fable, onyx, nova, shimmer)
OPENAI_VOICE=alloy

# ===============================================
# LOCAL AI (OFFLINE)
# ===============================================

# Lokal AI API URL
LOCAL_AI_URL=http://localhost:5000

# ===============================================
# DATABASE
# ===============================================

DB_HOST=localhost
DB_NAME=AsteraWeb
DB_USER=your_username
DB_PASS=your_password
DB_PORT=3306
DB_CHARSET=utf8mb4

# ===============================================
# ASTERISK
# ===============================================

# Asterisk SSH
ASTERISK_SSH_HOST=192.168.1.100
ASTERISK_SSH_PORT=22
ASTERISK_SSH_USER=root
ASTERISK_SSH_PASS=your_password

# Asterisk AMI
ASTERISK_AMI_HOST=192.168.1.100
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=admin
ASTERISK_AMI_PASS=your_password

# Asterisk Spool
ASTERISK_SPOOL_PATH=/var/spool/asterisk/outgoing/

# ===============================================
# CDR DATABASE (Asterisk CDR)
# ===============================================

CDR_DB_HOST=192.168.1.100
CDR_DB_NAME=asteriskcdrdb
CDR_DB_USER=asterisk_user
CDR_DB_PASS=your_password

# ===============================================
# CALLER ID & TRUNK
# ===============================================

CALLER_ID=02129999999
DEFAULT_TRUNK=SIP/provider

# ===============================================
# AI SETTINGS
# ===============================================

# Max konuşma süresi (saniye)
AI_MAX_DURATION=180

# Sessizlik timeout (saniye)
AI_TIMEOUT=10

# Dil
AI_LANGUAGE=tr-TR

# Temperature (0.0 - 1.0)
AI_TEMPERATURE=0.7

# ===============================================
# APPLICATION
# ===============================================

# Debug mode
APP_DEBUG=true

# Log level (debug, info, warning, error)
LOG_LEVEL=info

# Timezone
TIMEZONE=Europe/Istanbul

# ===============================================
# SECURITY
# ===============================================

# Session secret
SESSION_SECRET=your_random_secret_key_here

# JWT Secret (if using JWT)
JWT_SECRET=your_jwt_secret_here

# ===============================================
# EMAIL (Notification için)
# ===============================================

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=noreply@anabilim.com
MAIL_FROM_NAME=Anabilim Otomatik Arama

# ===============================================
# SMS (Notification için)
# ===============================================

SMS_PROVIDER=netgsm
SMS_USERNAME=your_username
SMS_PASSWORD=your_password
SMS_HEADER=ANABILIM

# ===============================================
# BACKUP
# ===============================================

BACKUP_PATH=/backups
BACKUP_RETENTION_DAYS=30

# ===============================================
# NOTLAR
# ===============================================
# - Tüm hassas bilgileri güçlü parolalarla değiştirin
# - Production'da APP_DEBUG=false yapın
# - .env dosyasını ASLA Git'e eklemeyin
# - Düzenli olarak yedek alın
